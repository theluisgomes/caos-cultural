# Copy to `.env.local` (gitignored) and fill values from:
# Firebase Console → Project settings → Your apps → Web app config
# Or: npx -y firebase-tools@latest apps:sdkconfig WEB <APP_ID> --project caos-cd876
#
# Active Firebase project: caos-cd876
# Firestore / Functions region: southamerica-east1

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional (Analytics)
# VITE_FIREBASE_MEASUREMENT_ID=

# Optional — connect to local Firebase Emulator Suite
# VITE_USE_FIREBASE_EMULATORS=true

# Optional (Google Maps — Phase 4)
# VITE_GOOGLE_MAPS_API_KEY=

# Gemini (seed Cloud Function + dev fallback) — server-side only in functions/
GEMINI_API_KEY=

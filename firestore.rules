rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userDoc().role == 'super_admin';
    }

    function isMemberRole(role) {
      return role in ['member', 'moderator', 'admin', 'super_admin'];
    }

    function keepsPlatformRoleUnchanged() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']);
    }

    function selfCreateUserOk() {
      return request.resource.data.role == 'member'
        && isMemberRole(request.resource.data.role);
    }

    match /users/{userId} {
      allow read: if true;
      allow create: if isSuperAdmin()
        || (isOwner(userId) && selfCreateUserOk());
      allow update: if isSuperAdmin()
        || (isOwner(userId) && keepsPlatformRoleUnchanged()
            && request.resource.data.role in ['member', 'moderator', 'admin', 'super_admin']);
      allow delete: if isSuperAdmin();
    }

    function agentOwnedByCaller(agentId) {
      return signedIn()
        && exists(/databases/$(database)/documents/agents/$(agentId))
        && get(/databases/$(database)/documents/agents/$(agentId)).data.ownerUserId == request.auth.uid;
    }

    match /agents/{id} {
      allow read: if resource.data.isPublic == true || isSuperAdmin()
        || (signedIn() && resource.data.ownerUserId == request.auth.uid);
      allow create: if signedIn()
        && (isSuperAdmin() || request.resource.data.ownerUserId == request.auth.uid);
      allow update, delete: if isSuperAdmin()
        || (signedIn() && resource.data.ownerUserId == request.auth.uid);
    }

    match /spaces/{id} {
      allow read: if resource.data.isPublished == true || isSuperAdmin()
        || (signedIn() && request.auth.uid in resource.data.managerUserIds);
      allow create: if signedIn()
        && (isSuperAdmin() || request.auth.uid in request.resource.data.managerUserIds);
      allow update, delete: if isSuperAdmin()
        || (signedIn() && request.auth.uid in resource.data.managerUserIds);
    }

    match /events/{id} {
      allow read: if resource.data.isPublished == true || isSuperAdmin()
        || (signedIn() && resource.data.createdByUserId == request.auth.uid);
      allow create: if signedIn()
        && (isSuperAdmin() || request.resource.data.createdByUserId == request.auth.uid);
      allow update, delete: if isSuperAdmin()
        || (signedIn() && resource.data.createdByUserId == request.auth.uid);
    }

    match /culturalProfiles/{id} {
      allow read: if resource.data.isPublished == true || isSuperAdmin()
        || (signedIn() && request.auth.uid in resource.data.managerUserIds);
      allow create: if signedIn()
        && (isSuperAdmin() || request.auth.uid in request.resource.data.managerUserIds);
      allow update, delete: if isSuperAdmin()
        || (signedIn() && request.auth.uid in resource.data.managerUserIds);
    }

    match /works/{id} {
      allow read: if resource.data.isPublished == true || isSuperAdmin()
        || (signedIn() && agentOwnedByCaller(resource.data.authorAgentId));
      allow create: if signedIn()
        && (isSuperAdmin() || agentOwnedByCaller(request.resource.data.authorAgentId));
      allow update, delete: if isSuperAdmin()
        || (signedIn() && agentOwnedByCaller(resource.data.authorAgentId));
    }

    match /interactions/{id} {
      allow read: if signedIn() && resource.data.actorUserId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.actorUserId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.actorUserId == request.auth.uid;
    }

    match /follows/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.followerUserId == request.auth.uid;
      allow delete: if signedIn() && resource.data.followerUserId == request.auth.uid;
    }

    match /agendas/{id} {
      allow read: if signedIn() && (resource.data.ownerUserId == request.auth.uid || resource.data.visibility == 'public');
      allow write: if signedIn() && request.resource.data.ownerUserId == request.auth.uid;
    }

    match /agendaItems/{id} {
      allow read: if signedIn() && resource.data.addedByUserId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.addedByUserId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.addedByUserId == request.auth.uid;
    }

    match /lists/{id} {
      allow read: if signedIn() && (resource.data.ownerUserId == request.auth.uid || resource.data.isPublic == true);
      allow write: if signedIn() && request.resource.data.ownerUserId == request.auth.uid;
    }

    match /listItems/{id} {
      allow read: if signedIn() && (
        get(/databases/$(database)/documents/lists/$(resource.data.listId)).data.ownerUserId == request.auth.uid
        || get(/databases/$(database)/documents/lists/$(resource.data.listId)).data.isPublic == true
      );
      allow create, update, delete: if signedIn()
        && get(/databases/$(database)/documents/lists/$(request.resource.data.listId)).data.ownerUserId == request.auth.uid;
    }

    match /boosts/{id} {
      allow read: if signedIn() && resource.data.actorUserId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.actorUserId == request.auth.uid;
    }

    match /verifications/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create, update: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    match /mapPins/{id} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
